# Daedalus Environment Configuration
# Copy this file to .env and update the values

# Session secret for authentication (REQUIRED)
# Generate a new one with: openssl rand -hex 32
SESSION_SECRET=5f8da4da5ff8b44dbb61d036c0590f3874b595a4c94fa6ccc647a72e6e177187

# Environment (development or production)
NODE_ENV=development

# Master database path (stores user accounts)
MASTER_DB_PATH=/Users/Owen/ScenarioAnalysis2/data/users.db

# User data directory (stores individual user databases)
USER_DATA_DIR=/Users/Owen/ScenarioAnalysis2/data/users

# Server port
PORT=3001
